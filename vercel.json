{
  "functions": {
    "api/seo.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/"
    },
    {
      "source": "/therapy",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/therapy"
    },
    {
      "source": "/community",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/community"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/privacy"
    },
    {
      "source": "/terms",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/terms"
    },
    {
      "source": "/apply",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/apply"
    },
    {
      "source": "/contact",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/contact"
    },
    {
      "source": "/breathe",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/breathe"
    },
    {
      "source": "/breathe/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/breathe/:slug"
    },
    {
      "source": "/therapist/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebot|facebookexternalhit|whatsapp|telegrambot|chatgpt|gptbot|claude|anthropic|perplexity|semrush|ahrefs|curl|wget|python).*" }],
      "destination": "/api/seo?path=/therapist/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/therapist/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=1800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600" }
      ]
    },
    {
      "source": "/(therapy|community|privacy|terms|apply|contact|breathe)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=1800" }
      ]
    },
    {
      "source": "/breathe/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=1800" }
      ]
    }
  ]
}
